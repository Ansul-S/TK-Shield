# TK-Shield configuration — copy to .env and adjust. ALL values are optional;
# the core pipeline runs fully offline with zero keys on these defaults.

# ── RAG / LLM (local Ollama — free, no key) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT=120

# ── Live patent monitoring (OPTIONAL, free key) ──────────────
# PatentsView retired its keyless API in Feb 2025. Request a free key at
# https://patentsview.org/apis/keyrequest — without it, live monitoring is
# skipped and the rest of TK-Shield is unaffected.
PATENTSVIEW_API_KEY=

# ── Keyless enrichment sources (no key needed) ───────────────
# Supplying an email/key only raises NCBI's rate limit.
NCBI_EMAIL=
PUBMED_API_KEY=

# Toggle individual sources off if desired:
ENABLE_PUBMED=true
ENABLE_WIKIDATA=true
ENABLE_GBIF=true
ENABLE_PATENTSVIEW=true

# ── Search / scoring ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
RRF_K=60
DEFAULT_N_RESULTS=5

# ── Storage paths ────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
PATENTS_COLLECTION=patents
TK_COLLECTION=tk_entries
TK_DB_PATH=data/tk_registry.sqlite3
PATENTS_CSV=data/raw/patents_medicinal.csv

# ── HTTP resilience ──────────────────────────────────────────
MAX_RETRIES=3
REQUEST_DELAY=0.5
HTTP_TIMEOUT=15
