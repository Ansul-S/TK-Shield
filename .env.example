# TK-Shield configuration — copy to .env and adjust. ALL values are optional;
# the core pipeline runs fully offline with zero keys on these defaults.

# ── RAG / LLM (local Ollama — free, no key) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT=120
# Cap generated tokens so a small local model can't run for minutes on a single
# report/novelty request (0 = model default).
LLM_NUM_PREDICT=900

# ── Live patent monitoring (FULLY OPTIONAL — not needed) ─────
# NOT required for the corpus: use PATENT_SOURCE=patentsview_bulk above for
# real metadata with zero keys. This key only enables the live "newly-filed
# patents" monitor tab; leave blank and everything else works.
PATENTSVIEW_API_KEY=

# ── Keyless enrichment sources (no key needed) ───────────────
# Supplying an email/key only raises NCBI's rate limit.
NCBI_EMAIL=
PUBMED_API_KEY=

# Toggle individual sources off if desired:
ENABLE_PUBMED=true
ENABLE_WIKIDATA=true
ENABLE_GBIF=true
ENABLE_PATENTSVIEW=true

# ── Corpus scale-up (real data volume) ───────────────────────
# Patent source for `python -m src.ingestion.build_corpus`:
#   ccdv             — keyless HuggingFace corpus (no download; low-fidelity metadata)
#   patentsview_bulk — keyless PatentsView bulk TSV; REAL metadata (~219MB) ← recommended, NO key
#   patentsview      — PatentsView live API (real metadata; needs the free key above)
PATENT_SOURCE=patentsview_bulk
MAX_PATENTS=20000
PATENT_CPC_CLASSES=A61K36,A01H,A23L,A61K8,A61Q,C12N15
EMBED_BATCH_SIZE=64

# PatentsView bulk (public files — no key, no registration). Files cache here;
# drop pre-downloaded *.tsv.zip in the dir to skip the download.
PATENTSVIEW_BULK_DIR=data/raw/bulk
BULK_ENRICH_ASSIGNEE=true

# TK registry source for `python -m src.ingestion.build_registry`:
#   duke     — Dr. Duke's CC0 ethnobotany (bulk)
#   wikidata — curated cross-region seed enriched with Wikidata multilingual aliases
TK_SOURCE=duke
TK_IMPORT_LIMIT=500
# Point at a locally-downloaded Dr. Duke ethnobotany CSV, or let it fetch the zip:
DUKE_CSV_PATH=data/raw/duke_ethnobotany.csv
DUKE_DATA_URL=https://ndownloader.figshare.com/files/43363335
# Enrich imported plants with Wikidata multilingual aliases (slower; capped):
ENRICH_MULTILINGUAL=false

# ── Search / scoring ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
RRF_K=60
DEFAULT_N_RESULTS=5
# HNSW distance metric for ChromaDB collections (pairs with normalized embeddings).
CHROMA_DISTANCE=cosine

# ── NLP ──────────────────────────────────────────────────────
# spaCy model for the NER extractor + preprocessor (English-first).
SPACY_MODEL=en_core_web_sm

# ── Prior-art enrichment fan-out ─────────────────────────────
ENRICH_WORKERS=8          # concurrent client calls
ENRICH_MAX_PLANTS=8       # max plants per entry to look up

# ── Text truncation limits (ingest/clients/LLM prompt) ───────
TITLE_MAX_CHARS=200
ABSTRACT_MAX_CHARS=500
PATENT_TEXT_MAX_CHARS=1500   # patent text fed to the novelty LLM prompt

# ── Researcher stats ─────────────────────────────────────────
STATS_PATENT_SAMPLE=5000     # cap the patent-metadata scan in /api/stats

# ── Risk model (interpretable; all tunable) ──────────────────
# Max points per factor (sum = 100).
RISK_WEIGHT_SIMILARITY=40
RISK_WEIGHT_TEMPORAL=20
RISK_WEIGHT_GEOGRAPHIC=15
RISK_WEIGHT_ASSIGNEE=15
RISK_WEIGHT_IPC=10
# How many top candidate patents the aggravating factors inspect.
RISK_TOP_N_CONSIDERED=3
# Aggravating factors (temporal/geographic/assignee/IPC) only apply when the top
# similarity is at least this — below it, risk reflects similarity alone, so a
# benign weakly-matching practice isn't inflated by structural factors.
RISK_RELEVANCE_GATE=0.50
# Band thresholds (inclusive lower bounds on the 0–100 total).
RISK_BAND_CRITICAL=80
RISK_BAND_HIGH=60
RISK_BAND_MEDIUM=40
RISK_BAND_LOW=20
# Examiner novelty verdict cosine-similarity thresholds.
NOVELTY_NOT_NOVEL=0.60
NOVELTY_POSSIBLE=0.45

# ── Corpus hygiene ───────────────────────────────────────────
# Comma-separated `source` substrings to EXCLUDE from the indexed corpus, so it
# is genuinely real-metadata patents (ccdv = the low-fidelity synthetic source).
EXCLUDE_PATENT_SOURCES=ccdv

# ── API hardening ────────────────────────────────────────────
# Allowed CORS origins ("*" = any; set a comma-separated allow-list before
# exposing the app to a network).
CORS_ORIGINS=*
# Max concurrent LLM-backed requests (/report, /novelty); excess → 503.
MAX_CONCURRENT_LLM=2
# Per-IP rate limiting (slowapi, in-memory, keyless). RATE_LIMIT_DEFAULT caps
# every API endpoint; RATE_LIMIT_LLM is the tighter cap on /report + /novelty.
# Exceeding either → HTTP 429. Set RATE_LIMIT_ENABLED=false to disable (e.g.
# load tests). Static assets, the SPA shell and /api/health are never throttled.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LLM=10/minute

# ── Storage paths ────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
PATENTS_COLLECTION=patents
TK_COLLECTION=tk_entries
TK_DB_PATH=data/tk_registry.sqlite3
PATENTS_CSV=data/raw/patents_medicinal.csv

# ── HTTP resilience ──────────────────────────────────────────
MAX_RETRIES=3
REQUEST_DELAY=0.5
HTTP_TIMEOUT=15
