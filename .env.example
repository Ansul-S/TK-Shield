# TK-Shield configuration — copy to .env and adjust. ALL values are optional;
# the core pipeline runs fully offline with zero keys on these defaults.

# ── RAG / LLM (local Ollama — free, no key) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT=120

# ── Live patent monitoring (FULLY OPTIONAL — not needed) ─────
# NOT required for the corpus: use PATENT_SOURCE=patentsview_bulk above for
# real metadata with zero keys. This key only enables the live "newly-filed
# patents" monitor tab; leave blank and everything else works.
PATENTSVIEW_API_KEY=

# ── Keyless enrichment sources (no key needed) ───────────────
# Supplying an email/key only raises NCBI's rate limit.
NCBI_EMAIL=
PUBMED_API_KEY=

# Toggle individual sources off if desired:
ENABLE_PUBMED=true
ENABLE_WIKIDATA=true
ENABLE_GBIF=true
ENABLE_PATENTSVIEW=true

# ── Corpus scale-up (real data volume) ───────────────────────
# Patent source for `python -m src.ingestion.build_corpus`:
#   ccdv             — keyless HuggingFace corpus (no download; low-fidelity metadata)
#   patentsview_bulk — keyless PatentsView bulk TSV; REAL metadata (~219MB) ← recommended, NO key
#   patentsview      — PatentsView live API (real metadata; needs the free key above)
PATENT_SOURCE=patentsview_bulk
MAX_PATENTS=20000
PATENT_CPC_CLASSES=A61K36,A01H,A23L,A61K8,A61Q,C12N15
EMBED_BATCH_SIZE=64

# PatentsView bulk (public files — no key, no registration). Files cache here;
# drop pre-downloaded *.tsv.zip in the dir to skip the download.
PATENTSVIEW_BULK_DIR=data/raw/bulk
BULK_ENRICH_ASSIGNEE=true

# TK registry source for `python -m src.ingestion.build_registry`:
#   duke     — Dr. Duke's CC0 ethnobotany (bulk)
#   wikidata — curated cross-region seed enriched with Wikidata multilingual aliases
TK_SOURCE=duke
TK_IMPORT_LIMIT=500
# Point at a locally-downloaded Dr. Duke ethnobotany CSV, or let it fetch the zip:
DUKE_CSV_PATH=data/raw/duke_ethnobotany.csv
DUKE_DATA_URL=https://ndownloader.figshare.com/files/43363335
# Enrich imported plants with Wikidata multilingual aliases (slower; capped):
ENRICH_MULTILINGUAL=false

# ── Search / scoring ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
RRF_K=60
DEFAULT_N_RESULTS=5

# ── Storage paths ────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
PATENTS_COLLECTION=patents
TK_COLLECTION=tk_entries
TK_DB_PATH=data/tk_registry.sqlite3
PATENTS_CSV=data/raw/patents_medicinal.csv

# ── HTTP resilience ──────────────────────────────────────────
MAX_RETRIES=3
REQUEST_DELAY=0.5
HTTP_TIMEOUT=15
